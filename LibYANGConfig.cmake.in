# CMake config package of libyang
#
# Imported target:
#   LibYANG::yang            the libyang library
#
# Variables:
#   LibYANG_VERSION          SO version of the library, compared by find_package()
#   LibYANG_PROJECT_VERSION  version of the libyang project
#   LibYANG_HAVE_CBOR        libyang supports the CBOR data format (LY_HAVE_CBOR)

@PACKAGE_INIT@

set(LibYANG_PROJECT_VERSION "@LIBYANG_VERSION@")
set(LibYANG_HAVE_CBOR @LY_HAVE_CBOR@)

# the LibYANG::yang target, generated by CMake next to this file
include("${CMAKE_CURRENT_LIST_DIR}/LibYANGTargets.cmake")
check_required_components(LibYANG)
