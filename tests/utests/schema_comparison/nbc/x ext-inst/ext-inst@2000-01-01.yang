module ext-inst {
    namespace "urn:test:ext-inst";
    prefix exi;
    yang-version 1.1;

    reference "no-ref";

    revision 2000-01-01;

    identity id;

    extension ex {
        argument name;
    }

    leaf l {
        type enumeration {
            enum e1 {
                exi:ex "my-ext";
            }
            enum e2;
        }
    }

    leaf k {
        type string {
            pattern 'a';
        }
    }
}
